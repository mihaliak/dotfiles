[user]
	name = Andrej Mihaliak
	email = andrej.mihaliak@gmail.com
	signingkey = EDB03A01921E535E
[github]
  user = mihaliak
[core]
	excludesfile = /Users/andrejmihaliak/.gitignore_global
[alias]
  a = "add ."
  c = commit
  p = push
  s = status -sb
  l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  m = !"bash -c 'git branch | grep -v 'master' | xargs git branch -D'"
  nah = !"bash -c 'git reset --hard && git clean -df'"
  master = checkout master
  main = checkout main
  yolo = !git commit -m \"$(curl -s whatthecommit.com/index.txt)\"
  joke = !git commit -m \"$(curl -s https://icanhazdadjoke.com)\"
  f = !"bash -c 'git checkout -b feature/$0'"
  o = !"bash -c 'git checkout $0'"
[pull]
	rebase = false
[commit]
	gpgsign = true
[init]
  defaultBranch = main
[gpg]
	program = /opt/homebrew/bin/gpg
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[safe]
	directory = /opt/homebrew/Library/Taps/homebrew/homebrew-core
	directory = /opt/homebrew/Library/Taps/homebrew/homebrew-cask
[tag]
	gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
